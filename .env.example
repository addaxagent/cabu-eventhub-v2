# GEMINI_API_KEY: Required for Gemini AI API calls (Optional).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

APP_ENV=testing
MOCK_PAYMENT_MODE=false

DPO_COMPANY_TOKEN=your_sandbox_company_token
DPO_SERVICE_TYPE=85325

DPO_API_BASE_URL=https://secure.3gdirectpay.com/API/v6/
DPO_PAYMENT_URL=https://secure.3gdirectpay.com/payv3.php

DPO_RETURN_URL=http://localhost:3000/payment/dpo/return
DPO_CANCEL_URL=http://localhost:3000/payment/dpo/cancel
DPO_RESULT_URL=http://localhost:3000/api/dpo/result

APP_BASE_URL=http://localhost:3000

ADMIN_EMAIL=itmanger@cabuniversity.com
ADMIN_PASSWORD=admin123
DPO_CURRENCY=ZMW

# Google Workspace Gmail SMTP Configuration (Server-Side Secrets)
GOOGLE_SMTP_HOST=smtp.gmail.com
GOOGLE_SMTP_PORT=587
GOOGLE_SMTP_SECURE=false
GOOGLE_SMTP_USER=noreply@cabuniversity.com
GOOGLE_SMTP_PASSWORD=
EMAIL_FROM=noreply@cabuniversity.com
EMAIL_FROM_NAME=CABU EventHub

# Airtel Zambia SMS Gateway Credentials (Server-Side Secrets)
AIRTEL_SMS_CUSTOMER_ID=
AIRTEL_SMS_USERNAME=
AIRTEL_SMS_PASSWORD=
AIRTEL_SMS_SUBACCOUNT_ID=
AIRTEL_SMS_SENDER_ID=CABU
AIRTEL_SMS_BASE_URL=https://www.airtel.co.zm/gateway/v1/sendDefaultSms

